# Required for the website chatbot server function.
# Add the real value in Vercel Project Settings > Environment Variables.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna

# Optional shared rate limiting. If omitted, the chatbot uses a small
# per-server in-memory fallback limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
