{
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://googleads.g.doubleclick.net; connect-src 'self' https://google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://googletagmanager.com https://*.googletagmanager.com https://g.doubleclick.net https://*.g.doubleclick.net https://doubleclick.net https://*.doubleclick.net https://vitals.vercel-insights.com https://vitals.vercel-analytics.com https://www.google.com; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp-endpoint;"
        },
        {
          "key": "Report-To",
          "value": "{\"group\":\"csp-endpoint\",\"max_age\":10886400,\"endpoints\":[{\"url\":\"https://www.computerrepairkuwait.com/api/csp-report\"}]}"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/macbook-repair",
      "destination": "/macbook-repair-kuwait",
      "permanent": true
    },
    {
      "source": "/screen-replacement",
      "destination": "/laptop-screen-repair-kuwait",
      "permanent": true
    },
    {
      "source": "/laptop-repair-hawalli-kuwait",
      "destination": "/laptop-repair-kuwait",
      "permanent": true
    },
    {
      "source": "/faq/:faqSlug",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/services/:serviceSlug",
      "destination": "/:serviceSlug",
      "permanent": true
    },
    {
      "source": "/laptop-repair-in-farwaniya",
      "destination": "/location/farwaniya",
      "permanent": true
    },
    {
      "source": "/laptop-repair-in-abu-halifa",
      "destination": "/location/ahmadi",
      "permanent": true
    },
    {
      "source": "/laptop-repair-in-fahaheel",
      "destination": "/location/ahmadi",
      "permanent": true
    },
    {
      "source": "/laptop-repair-in-riqqa",
      "destination": "/location/ahmadi",
      "permanent": true
    },
    {
      "source": "/laptop-repair-in-mangaf",
      "destination": "/location/ahmadi",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
